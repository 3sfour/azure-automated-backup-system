STORAGE_ACCOUNT=<your-storage-account-name>

DOCUMENTS_DIR=/path/to/documents
DBEXPORTS_DIR=/path/to/db-exports
APPFILES_DIR=/path/to/app-files

# SAS tokens WITHOUT the leading question mark. Keep expiry short. Never commit backup.env.
SAS_DOCUMENTS=<sas-token-for-documents-container>
SAS_DBEXPORTS=<sas-token-for-db-exports-container>
SAS_APPFILES=<sas-token-for-app-files-container>
